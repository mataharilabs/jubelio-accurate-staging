# Salin ke .env.local untuk pengembangan. Jangan commit .env.local.

# Alamat aplikasi. Dipakai untuk cookie aman (https) dan redirect OAuth Accurate.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3847

# Rahasia penandatangan sesi admin. Wajib. Ganti dengan string acak panjang.
AUTH_SECRET=ganti-dengan-string-acak-panjang

# Mode lokal (aktif selama ketiga variabel Supabase di bawah kosong).
# Hapus atau kosongkan keduanya setelah Supabase Auth dipakai.
DEMO_ADMIN_EMAIL=admin@asiacommerce.local
DEMO_ADMIN_PASSWORD=ganti-sandi-ini

# Supabase. Isi ketiganya agar data dan login pindah dari berkas lokal ke Postgres.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Accurate Online — daftar aplikasi di https://account.accurate.id (area developer).
# Jangan pernah menaruh nilai ini di kode. Redirect URI harus sama dengan yang didaftarkan.
# ACCURATE_CLIENT_ID=
# ACCURATE_CLIENT_SECRET=
# ACCURATE_REDIRECT_URI=http://127.0.0.1:3847/api/accurate/callback
# ID database bisa diisi di sini atau di halaman Pengaturan.
# ACCURATE_DATABASE_ID=
